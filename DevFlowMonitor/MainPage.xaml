<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DevFlowMonitor.MainPage"
             Title="DevFlow Monitor">

   <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="8">

      <!-- Row 0: Monitor start/stop controls -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
         <Label x:Name="StatusLabel"
                Grid.Column="0"
                Text="Idle — press Start to monitor"
                VerticalOptions="Center"
                LineBreakMode="WordWrap" />
         <Button x:Name="MonitorBtn"
                 Grid.Column="1"
                 Text="Start"
                 AutomationId="MonitorBtn"
                 Clicked="OnMonitorClicked"
                 WidthRequest="80" />
      </Grid>

      <!-- Row 1: Action toolbar (Screenshot + Tree, enabled when agent is selected) -->
      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">

         <Button x:Name="ScreenshotBtn"
                 Grid.Column="0"
                 Text="📷 Screenshot"
                 AutomationId="ScreenshotBtn"
                 Clicked="OnScreenshotClicked"
                 IsEnabled="False" />

         <Button x:Name="TreeBtn"
                 Grid.Column="1"
                 Text="🌳 Tree"
                 AutomationId="TreeBtn"
                 Clicked="OnTreeClicked"
                 IsEnabled="False" />

         <Button x:Name="TapCounterBtn"
                 Grid.Column="2"
                 Text="👆 Tap CounterBtn"
                 AutomationId="TapCounterBtn"
                 Clicked="OnTapCounterBtnClicked"
                 IsEnabled="False" />

         <Button x:Name="AdbForwardBtn"
                 Grid.Column="3"
                 Text="🔗 ADB Forward"
                 AutomationId="AdbForwardBtn"
                 Clicked="OnAdbForwardClicked"
                 ToolTipProperties.Text="Run adb reverse tcp:19223 tcp:19223 on emulator-5554 so the Android DevFlow agent can reach the broker" />
         <Label x:Name="ActionStatusLabel"
                Grid.Column="4"
                Text="Select an agent below"
                VerticalOptions="Center"
                FontSize="12"
                TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
         
         <ActivityIndicator x:Name="Busy"
                            Grid.Column="5"
                            IsRunning="False"
                            IsVisible="False"
                            Color="{StaticResource Primary}"
                            WidthRequest="24"
                            HeightRequest="24"
                            VerticalOptions="Center" />
      </Grid>

      <!-- Row 2: 3-column panel — agents | screenshot | tree -->
      <Grid Grid.Row="2" ColumnDefinitions="*,*,*">

         <!-- Col 0: Agent list -->
         <CollectionView x:Name="AgentsView"
                         Grid.Column="0"
                         ItemsSource="{Binding Agents}"
                         SelectionMode="Single"
                         SelectionChanged="OnAgentSelectionChanged"
                         EmptyView="No agents connected">
            <CollectionView.ItemTemplate>
               <DataTemplate>
                  <Frame Margin="0,4" Padding="12" CornerRadius="8" HasShadow="True">
                     <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Grid.Row="0"
                               Text="{Binding AppName}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Grid.Row="1"
                               Text="{Binding Platform}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                        <Label Grid.Row="2"
                               Text="{Binding Tfm}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                        <Label Grid.Row="3"
                               Text="{Binding ConnectedAt, StringFormat='Connected: {0}'}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=DarkGray, Dark=Silver}" />
                     </Grid>
                  </Frame>
               </DataTemplate>
            </CollectionView.ItemTemplate>
         </CollectionView>

         <!-- Col 1: Screenshot image -->
         <Image x:Name="ScreenshotImage"
                Grid.Column="1"
                IsVisible="False"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Fill" />

         <!-- Col 2: Hierarchical tree view -->
         <Grid x:Name="TreeColumn"
               Grid.Column="2"
               RowDefinitions="*,Auto"
               RowSpacing="4"
               IsVisible="False">

            <!-- Tree node list -->
            <CollectionView x:Name="TreeView"
                            Grid.Row="0"
                            ItemsSource="{Binding TreeItems}"
                            SelectionMode="Single"
                            SelectionChanged="OnTreeNodeSelected"
                            EmptyView="Tree not loaded — press 🌳 Tree">
               <CollectionView.ItemTemplate>
                  <DataTemplate>
                     <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                           ColumnSpacing="3"
                           Padding="{Binding IndentPadding}"
                           HeightRequest="26">

                        <!-- Expand / collapse toggle -->
                        <Label Grid.Column="0"
                               Text="{Binding ExpandIcon}"
                               FontSize="13"
                               WidthRequest="16"
                               VerticalOptions="Center">
                           <Label.GestureRecognizers>
                              <TapGestureRecognizer CommandParameter="{Binding}"
                                                    Tapped="OnExpandToggled" />
                           </Label.GestureRecognizers>
                        </Label>

                        <!-- Type icon -->
                        <Label Grid.Column="1"
                               Text="{Binding TypeIcon}"
                               FontSize="12"
                               VerticalOptions="Center" />

                        <!-- Short type name -->
                        <Label Grid.Column="2"
                               Text="{Binding DisplayType}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0066CC, Dark=#66AAFF}"
                               VerticalOptions="Center" />

                        <!-- AutomationId / text / empty -->
                        <Label Grid.Column="3"
                               Text="{Binding DisplayLabel}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}"
                               LineBreakMode="TailTruncation"
                               VerticalOptions="Center" />

                        <!-- "hidden" badge -->
                        <Label Grid.Column="4"
                               Text="hidden"
                               FontSize="9"
                               TextColor="Gray"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               IsVisible="{Binding IsHiddenNode}" />
                     </Grid>
                  </DataTemplate>
               </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Selected-node detail panel -->
            <Frame x:Name="NodeDetailFrame"
                   Grid.Row="1"
                   IsVisible="False"
                   Padding="10,8"
                   CornerRadius="6"
                   HasShadow="False"
                   BackgroundColor="{AppThemeBinding Light=#EEF4FF, Dark=#1A2035}">
               <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                  <Label Grid.Row="0"
                         Text="{Binding SelectedTreeNode.FullTypeLabel}"
                         FontAttributes="Bold"
                         FontSize="12" />
                  <Label Grid.Row="1"
                         Text="{Binding SelectedTreeNode.IdLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />
                  <Label Grid.Row="2"
                         Text="{Binding SelectedTreeNode.AutomationIdLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasAutomationId}" />
                  <Label Grid.Row="3"
                         Text="{Binding SelectedTreeNode.TextLabel}"
                         FontSize="11"
                         IsVisible="{Binding SelectedTreeNode.HasText}" />
                  <Label Grid.Row="4"
                         Text="{Binding SelectedTreeNode.BoundsLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
                  <Label Grid.Row="5"
                         Text="{Binding SelectedTreeNode.StateLabel}"
                         FontSize="10"
                         TextColor="{AppThemeBinding Light=DimGray, Dark=Silver}" />
               </Grid>
            </Frame>

         </Grid>

      </Grid>

   </Grid>

</ContentPage>
